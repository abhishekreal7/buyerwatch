{
  "manifest_version": 3,
  "name": "BuyerWatch Reddit Connector",
  "description": "Connect BuyerWatch to the Reddit account already signed in to Chrome.",
  "version": "1.0.0",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://reddit.com/*",
    "https://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://buyerwatch.co/*",
      "https://www.buyerwatch.co/*"
    ],
    "accepts_tls_channel_id": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://reddit.com/*",
        "https://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BuyerWatch Reddit Connector",
    "default_popup": "popup.html"
  }
}
