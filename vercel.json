{
  "crons": [
    {
      "path": "/api/cron/enqueue",
      "schedule": "0 0 * * *"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
