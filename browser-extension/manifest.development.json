{
  "manifest_version": 3,
  "name": "BuyerWatch Development",
  "description": "Local development build of the BuyerWatch Reddit capture extension.",
  "version": "1.0.0",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://buyerwatch.co/*",
    "https://www.buyerwatch.co/*",
    "http://localhost:3000/*",
    "https://nenarlpygxtkdxbjqrtb.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://buyerwatch.co/*",
      "https://www.buyerwatch.co/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ],
    "accepts_tls_channel_id": false
  },
  "action": {
    "default_title": "Capture with BuyerWatch Development",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://buyerwatch.co/*",
        "https://www.buyerwatch.co/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "common.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.reddit.com/r/*/comments/*",
        "https://reddit.com/r/*/comments/*",
        "https://*.reddit.com/comments/*",
        "https://reddit.com/comments/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
