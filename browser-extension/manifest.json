{
  "manifest_version": 3,
  "name": "BuyerWatch",
  "description": "Capture Reddit conversations and safely prefill BuyerWatch replies.",
  "version": "0.4.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://buyerwatch.co/*",
    "https://www.buyerwatch.co/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*",
    "https://*.reddit.com/*",
    "https://reddit.com/*"
  ],
  "action": {
    "default_title": "Capture with BuyerWatch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://buyerwatch.co/*",
        "https://www.buyerwatch.co/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
