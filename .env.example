# Public application origin, used for OAuth and email redirects. Required in production.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@scouto.co
NEXT_PUBLIC_BUYERWATCH_LEGACY_REVIEW=0

# Supabase project connection. All three are required in production.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application encryption key: 64 hexadecimal characters (32 bytes).
ENCRYPTION_KEY=

# Redis/BullMQ connection. Use rediss:// in production.
UPSTASH_REDIS_URL=rediss://default:password@example.upstash.io:6379

# Random secrets used by Vercel Cron and the worker queue dashboard (32+ characters).
CRON_SECRET=
ADMIN_SECRET=
ADMIN_EMAILS=admin@buyerwatch.co

# Free QStash schedule for serverless Reddit monitoring. Copy these three
# values from the QStash dashboard and add them to the Vercel project.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SERVERLESS_MONITOR_MAX_SCORES=1
SERVERLESS_MONITOR_MAX_TARGETS=50

# Stable deployment identifiers for rolling/self-hosted Next.js releases.
DEPLOYMENT_VERSION=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Dodo Payments. Optional at launch; set the API key, all subscription product
# IDs, webhook secret, and explicit environment together to enable billing.
# Add-on product IDs are optional, but must be configured as a pair.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_PRO_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_STARTER_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_PRO_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_SIGNAL_PACK_PRODUCT_ID=
DODO_PAYMENTS_DRAFT_PACK_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Claude Sonnet powers intent scoring, onboarding intelligence, and reply drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_INTENT_MODEL=claude-sonnet-5
INTENT_AI_PREFLIGHT_THRESHOLD=0.55
INTENT_MAX_POST_AGE_DAYS=45
# Margin guardrails. Reservations prevent concurrent workers from crossing caps.
ANTHROPIC_INTENT_RESERVATION_USD=0.025
ANTHROPIC_DRAFT_RESERVATION_USD=0.035
ANTHROPIC_FREE_MONTHLY_SPEND_LIMIT_USD=1
ANTHROPIC_PRO_MONTHLY_SPEND_LIMIT_USD=10
ANTHROPIC_GROWTH_MONTHLY_SPEND_LIMIT_USD=40
ANTHROPIC_GLOBAL_MONTHLY_SPEND_LIMIT_USD=200

# Reddit discovery. Official app credentials are an optional read fallback.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BuyerWatch/1.0 (contact: support@buyerwatch.co)
REDDIT_API_APPROVED=false
REDDITAPIS_API_KEY=
# redditapis.com costs money per request. Keep disabled unless you explicitly
# choose the paid fallback and have set a spending limit with the provider.
REDDITAPIS_FALLBACK_ENABLED=false
REDDITAPIS_FORCE_LIVE=false
# Independent write kill switch. Customer passwords and TOTP secrets are used
# only for the one-time login request and are never stored.
REDDITAPIS_POSTING_ENABLED=false

# Bluesky discovery uses the public AppView and needs no shared credentials.
# These optional credentials are only for a connected posting account.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# X discovery must use an approved X developer app; keyless scraping is not used.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_SEARCH_COST_CENTS=5
ENABLE_X_DISCOVERY=false
ENABLE_THREADS_DISCOVERY=false

# Email and enrichment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scouto <notifications@example.com>
EMAIL_UNSUBSCRIBE_SECRET=
DIGEST_WEEKDAY_UTC=1
DIGEST_HOUR_UTC=8
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Observability and worker runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
HEALTHCHECK_PING_URL=
WORKER_HEALTHCHECK_URL=
WORKER_PORT=3001
PORT=3001
LOG_LEVEL=info

# Development/test only. These flags are ignored in production.
USE_MOCK_DRAFTS=false
USE_MOCK_BLUESKY=false
USE_MOCK_X=false
