# Public application origin, used for OAuth and email redirects. Required in production.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@scouto.co
NEXT_PUBLIC_BUYERWATCH_LEGACY_REVIEW=0

# Supabase project connection. All three are required in production.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application encryption key: 64 hexadecimal characters (32 bytes).
ENCRYPTION_KEY=

# Redis/BullMQ connection. Use rediss:// in production.
UPSTASH_REDIS_URL=rediss://default:password@example.upstash.io:6379

# Random secrets used by Vercel Cron and the worker queue dashboard (32+ characters).
CRON_SECRET=
ADMIN_SECRET=
ADMIN_EMAILS=admin@buyerwatch.co

# Free QStash schedule for serverless Reddit monitoring. Copy these three
# values from the QStash dashboard and add them to the Vercel project.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SERVERLESS_MONITOR_MAX_SCORES=1
SERVERLESS_MONITOR_MAX_TARGETS=50

# Optional Cloudflare RSS shadow monitor. Leave blank until the Worker is
# deployed. This proves public RSS health in parallel; it never creates leads,
# spends customer credits, drafts replies, or changes auto-send behavior.
CLOUDFLARE_RSS_SHADOW_SECRET=
CLOUDFLARE_RSS_SHADOW_MAX_TARGETS=10

# Stable deployment identifiers for rolling/self-hosted Next.js releases.
DEPLOYMENT_VERSION=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Dodo Payments. Optional at launch; set the API key, all subscription product
# IDs, webhook secret, and explicit environment together to enable billing.
# Add-on product IDs are optional, but must be configured as a pair.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_PRO_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_STARTER_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_PRO_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_SIGNAL_20_PRODUCT_ID=
DODO_PAYMENTS_SIGNAL_50_PRODUCT_ID=
DODO_PAYMENTS_SIGNAL_120_PRODUCT_ID=
DODO_PAYMENTS_DRAFT_5_PRODUCT_ID=
DODO_PAYMENTS_DRAFT_12_PRODUCT_ID=
DODO_PAYMENTS_DRAFT_30_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Claude Sonnet powers intent scoring, onboarding intelligence, and reply drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_INTENT_MODEL=claude-sonnet-5
INTENT_AI_PREFLIGHT_THRESHOLD=0.55
INTENT_MAX_POST_AGE_DAYS=45
# Margin guardrails. Reservations prevent concurrent workers from crossing caps.
ANTHROPIC_INTENT_RESERVATION_USD=0.025
ANTHROPIC_DRAFT_RESERVATION_USD=0.035
ANTHROPIC_FREE_MONTHLY_SPEND_LIMIT_USD=1
ANTHROPIC_PRO_MONTHLY_SPEND_LIMIT_USD=10
ANTHROPIC_GROWTH_MONTHLY_SPEND_LIMIT_USD=40
ANTHROPIC_GLOBAL_MONTHLY_SPEND_LIMIT_USD=200

# Reddit discovery. RSS remains a best-effort fallback only; production
# discovery uses the managed provider when this explicit switch is enabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BuyerWatch/1.0 (contact: support@buyerwatch.co)
REDDIT_API_APPROVED=false
REDDITAPIS_API_KEY=
# redditapis.com costs money per request. Keep disabled unless you explicitly
# choose managed discovery and have set a spending limit with the provider.
REDDITAPIS_DISCOVERY_ENABLED=false
# Legacy compatibility alias. Do not enable this in new environments.
REDDITAPIS_FALLBACK_ENABLED=false
REDDITAPIS_FORCE_LIVE=false
# Independent write kill switch. Customer passwords and TOTP secrets are used
# only for the one-time login request and are never stored.
REDDITAPIS_POSTING_ENABLED=false
# Hard shared cost ceilings (UTC day). The provider call is rejected before it
# starts when a ceiling is reached. Tune only after reviewing real usage.
REDDITAPIS_MAX_DAILY_READ_CALLS=250
REDDITAPIS_MAX_DAILY_WRITE_CALLS=10
# Cache paid discovery results for 5-30 minutes. Empty feeds are cached too.
REDDITAPIS_DISCOVERY_CACHE_SECONDS=900
# Verify inbound replies to BuyerWatch-posted comments. One bounded RedditAPIs
# read runs per interval; it never affects posting and may be disabled safely.
REDDIT_REPLY_TRACKING_ENABLED=true
REDDIT_REPLY_TRACKING_INTERVAL_MINUTES=60
# Automatic delivery is disabled for unestablished Reddit accounts.
REDDIT_AUTO_MIN_ACCOUNT_AGE_DAYS=30
REDDIT_AUTO_MIN_COMBINED_KARMA=50

# Passwordless cloud-browser delivery. BuyerWatch stores an encrypted profile
# ID per connected account; the API key stays server-side and Reddit login state
# remains in Hyperbrowser. Recording, proxying, stealth, and log capture are
# disabled by the application. Hyperbrowser takes priority over RedditAPIs.
HYPERBROWSER_API_KEY=
HYPERBROWSER_POSTING_ENABLED=false
# Alert when the team has this percentage of Hyperbrowser credits remaining.
HYPERBROWSER_CREDIT_ALERT_PERCENT=20

# Preferred official Reddit data-partner integration. Obtain these values from
# an approved Sprinklr Listening/Publishing API contract, then enable discovery
# and posting independently. Sprinklr takes priority over RedditAPIs when both
# switches are enabled. Do not place real secrets in this example file.
SPRINKLR_API_BASE_URL=
SPRINKLR_API_KEY=
SPRINKLR_ACCESS_TOKEN=
SPRINKLR_WORKSPACE_ID=
SPRINKLR_REDDIT_TOPIC_ID=
SPRINKLR_REDDIT_ACCOUNT_ID=
SPRINKLR_REDDIT_CHANNEL_ID=
SPRINKLR_REDDIT_CAMPAIGN_ID=
SPRINKLR_REDDIT_DISCOVERY_ENABLED=false
SPRINKLR_REDDIT_POSTING_ENABLED=false
SPRINKLR_DISCOVERY_CACHE_SECONDS=120
REDDIT_PROVIDER_FORCE_LIVE=false

# Bluesky discovery uses the public AppView and needs no shared credentials.
# These optional credentials are only for a connected posting account.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# X discovery must use an approved X developer app; keyless scraping is not used.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_SEARCH_COST_CENTS=5
ENABLE_X_DISCOVERY=false
ENABLE_THREADS_DISCOVERY=false

# Email and enrichment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scouto <notifications@example.com>
EMAIL_UNSUBSCRIBE_SECRET=
DIGEST_WEEKDAY_UTC=1
DIGEST_HOUR_UTC=8
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Observability and worker runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
HEALTHCHECK_PING_URL=
WORKER_HEALTHCHECK_URL=
WORKER_PORT=3001
PORT=3001
LOG_LEVEL=info

# Development/test only. These flags are ignored in production.
USE_MOCK_DRAFTS=false
USE_MOCK_BLUESKY=false
USE_MOCK_X=false
