# Public application origin, used for OAuth and email redirects. Required in production.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Supabase project connection. All three are required in production.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application encryption key: 64 hexadecimal characters (32 bytes).
ENCRYPTION_KEY=

# Redis/BullMQ connection. Use rediss:// in production.
UPSTASH_REDIS_URL=rediss://default:password@example.upstash.io:6379

# Random secrets used by Vercel Cron and the worker queue dashboard (32+ characters).
CRON_SECRET=
ADMIN_SECRET=
ADMIN_EMAILS=admin@example.com

# Stable deployment identifiers for rolling/self-hosted Next.js releases.
DEPLOYMENT_VERSION=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Dodo Payments. Optional at launch; set all four values together to enable billing.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRO_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=

# At least one drafting provider is required in production. Gemini can operate
# alone until Anthropic credentials are available.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VERTEX_MODEL=gemini-2.0-flash-001

# Reddit discovery and user OAuth. These are optional; the future Chrome
# extension can write normalized captures into the ingestion_events table.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_SECRET=
REDDIT_USER_AGENT=Scouto/1.0
REDDIT_API_APPROVED=false
REDDITAPIS_API_KEY=
REDDITAPIS_FORCE_LIVE=false

# Optional platform discovery integrations.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_SEARCH_COST_CENTS=5

# Email and enrichment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scouto <notifications@example.com>
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GCP_PROJECT=
GCP_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=

# Observability and worker runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
HEALTHCHECK_PING_URL=
WORKER_HEALTHCHECK_URL=
WORKER_PORT=3001
LOG_LEVEL=info

# Development/test only. These flags are ignored in production.
USE_MOCK_DRAFTS=false
USE_MOCK_BLUESKY=false
USE_MOCK_X=false
